# /etc/nodewatch/api.env   chmod 600, root-owned. Never commit this.
# Supabase -> Settings -> Database -> Connection string (URI), session pooler.
NW_DATABASE_URL=postgresql://postgres.jcprvuqhnjtgskjuoded:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# openssl rand -hex 32
NW_JWT_SECRET=REPLACE_WITH_RANDOM_HEX
NW_JWT_TTL_MIN=15
# "aws" verifies enrolment against EC2. "off" is local development only.
NW_VERIFY_MODE=aws
AWS_DEFAULT_REGION=ap-south-1
